# MatrixFlow Enterprise – resumen de variables de entorno
# Copie backend/.env.example → backend/.env y frontend/.env.example → frontend/.env para trabajar en local.
#
# ┌──────────────┬───────────────────────────┬──────────────────────────────────────────────┐
# │ Servicio     │ Variable                  │ Valor                                        │
# ├──────────────┼───────────────────────────┼──────────────────────────────────────────────┤
# │ Render (API) │ DATABASE_URL              │ Cadena "Session pooler" de Supabase          │
# │ Render (API) │ SECRET_KEY                │ Generada automáticamente por render.yaml     │
# │ Render (API) │ CORS_ORIGINS              │ https://<su-proyecto>.vercel.app             │
# │ Render (API) │ ADMIN_PASSWORD            │ Contraseña inicial del administrador         │
# │ Render (API) │ DEMO_USERS_PASSWORD       │ Contraseña de analista y gerencia            │
# │ Vercel (web) │ VITE_API_URL              │ https://<su-api>.onrender.com/api/v1         │
# │ Vercel (web) │ VITE_SHOW_DEMO_USERS      │ true / false                                 │
# └──────────────┴───────────────────────────┴──────────────────────────────────────────────┘

# Backend
DATABASE_URL=postgresql://matrixflow:matrixflow@localhost:5432/matrixflow
SECRET_KEY=cambie-esta-clave
CORS_ORIGINS=http://localhost:5173
ADMIN_PASSWORD=Admin2026!
DEMO_USERS_PASSWORD=Demo2026!

# Frontend
VITE_API_URL=
VITE_SHOW_DEMO_USERS=true
