# ---------- Backend (FastAPI) ----------
# Local con Docker:  postgresql://aurea:aurea@localhost:5432/aurea
# Supabase: Project → Connect → "Session pooler" (IPv4, puerto 5432). Reemplace [YOUR-PASSWORD].
#   postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://aurea:aurea@localhost:5432/aurea

ENVIRONMENT=development
# Genere una clave: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambie-esta-clave
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Orígenes permitidos (separados por coma) y regex opcional para previews de Vercel
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN_REGEX=

# Carga inicial de TecnoAndes Distribuciones S.A.C.
SEED_ON_START=true
ADMIN_EMAIL=admin@tecnoandes.pe
ADMIN_PASSWORD=Admin2026!
DEMO_USERS_PASSWORD=Demo2026!

# Zona horaria para la actividad diaria del carnet
TIMEZONE=America/Lima

# Reconocimiento facial (DNI + rostro)
FACE_LOGIN_ENABLED=true
FACE_MATCH_THRESHOLD=0.5
FACE_MAX_FAILED_ATTEMPTS=5
FACE_LOCK_MINUTES=15

# Ubicación del inicio de sesión (Nominatim / OpenStreetMap; respaldo por IP con ipapi.co)
GEOLOCATION_ENABLED=true
GEOCODER_CONTACT=soporte@tecnoandes.pe
