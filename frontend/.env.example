# ---------- Frontend (Vite) ----------
# En Vercel defina la URL pública de la API en Render (incluya /api/v1):
#   VITE_API_URL=https://matrixflow-api.onrender.com/api/v1
# En local puede dejarla vacía: Vite redirige /api a http://localhost:8000
VITE_API_URL=

# 'true' muestra los usuarios de demostración en la pantalla de login
VITE_SHOW_DEMO_USERS=true
